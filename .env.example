# Firebase Client Configuration for Kalulini Boys High School SMS
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK Configuration (Server-side, choose one method for production)
# Method 1: JSON Service Account string or Base64 string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Method 2: Individual variables
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Method 3: Path to credentials file (standard Google Cloud)
GOOGLE_APPLICATION_CREDENTIALS=

# Application Metadata
NEXT_PUBLIC_SCHOOL_NAME="Kalulini Boys High School"
NEXT_PUBLIC_SCHOOL_MOTTO="Strive for Excellence, Integrity and Service"
NEXT_PUBLIC_SCHOOL_LOCATION="Makueni County, Kenya"
NEXT_PUBLIC_SCHOOL_EMAIL="info@kaluliniboys.ac.ke"
NEXT_PUBLIC_SCHOOL_PHONE="+254 700 000 000"

# Optional Production Server Port (Default is 3000)
PORT=3000
